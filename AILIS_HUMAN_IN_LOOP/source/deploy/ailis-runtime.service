[Unit]
Description=AILIS Hosted Agent Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ailis
Group=ailis
WorkingDirectory=/opt/ailis/source
EnvironmentFile=/etc/ailis/ailis.env
Environment=NODE_ENV=production
Environment=PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node/bin/node scripts/start-ailis-hosted-runtime.cjs
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/ailis/runtime-data /opt/ailis/logs
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
