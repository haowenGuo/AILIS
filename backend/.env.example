APP_NAME=AILIS Backend
DEBUG=False
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://haowenguo.github.io
# 可选，不填时默认使用 backend/data 目录
# DATA_DIR=
# 可选，不填时默认使用 backend/data/app.db
# DATABASE_URL=
# 生产建议 PostgreSQL；DATABASE_AUTO_CREATE=false 时由迁移工具管理表结构
DATABASE_AUTO_CREATE=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# 可选，不填时默认使用 backend/data/chroma
# CHROMA_PERSIST_DIR=

# Redis 分布式状态。默认 memory 保持单机兼容；生产多实例改为 redis。
REDIS_URL=
AILIS_RELAY_STATE_BACKEND=memory

# 对象存储。默认 local 保持旧行为；生产可使用 S3/OSS/MinIO/R2 兼容接口。
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# 教学子系统
EDU_SESSION_COOKIE_NAME=simteach_session
EDU_SESSION_TTL_DAYS=14
EDU_TEACHER_INVITE_CODE=teacher-demo
EDU_PASSWORD_PEPPER=
EDU_SEED_ADMIN=true
EDU_ADMIN_EMAIL=admin@simclass.local
EDU_ADMIN_PASSWORD=Admin@123456
EDU_ADMIN_PHONE=13800000000
EDU_ADMIN_SCHOOL_NAME=仿真人教学教室
EDU_HF_DATASET_VIEWER_URL=https://datasets-server.huggingface.co
EDU_HF_QUESTION_DATASET=SeaLLMs/SeaExam
EDU_HF_QUESTION_CONFIG=m3exam-chinese
EDU_HF_QUESTION_SPLIT=test
EDU_QUESTION_BANK_CACHE_TTL_SECONDS=900

# LLM
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your_llm_api_key
LLM_MODEL_NAME=doubao-seed-2-0-mini-260215

# 完整 AILIS Hosted Runtime（Node 服务仅监听 127.0.0.1）
AILIS_HOSTED_RUNTIME_ENABLED=true
AILIS_HOSTED_RUNTIME_URL=http://127.0.0.1:18777
AILIS_HOSTED_RUNTIME_INTERNAL_TOKEN=replace_with_a_long_random_internal_token
AILIS_HOSTED_RUNTIME_TIMEOUT_SECONDS=360
AILIS_WEB_SESSION_SECRET=replace_with_a_long_random_web_session_secret
AILIS_WEB_SESSION_TTL_DAYS=180
AILIS_LLM_RELAY_ENABLED=true
AILIS_LLM_RELAY_MAX_BYTES=4194304
AILIS_LLM_RELAY_REQUESTS_PER_MINUTE=30
AILIS_LLM_RELAY_MAX_CONCURRENT_PER_SESSION=2
AILIS_LLM_RELAY_IP_REQUESTS_PER_MINUTE=60
AILIS_LLM_RELAY_GLOBAL_REQUESTS_PER_MINUTE=300
AILIS_LLM_RELAY_GLOBAL_MAX_CONCURRENT=12
# 仅当后端只接受可信反向代理流量时开启，避免伪造 X-Forwarded-For 绕过限流。
AILIS_LLM_RELAY_TRUST_PROXY_HEADERS=false
AILIS_HOSTED_HTTP_MAX_CONNECTIONS=100
AILIS_HOSTED_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
AILIS_HOSTED_HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# 官网账号 / 会员
APP_SESSION_COOKIE_NAME=ailis_session
APP_CSRF_COOKIE_NAME=ailis_csrf
APP_SESSION_TTL_DAYS=30
APP_SESSION_COOKIE_SECURE=true
APP_SESSION_COOKIE_SAMESITE=lax
APP_PASSWORD_PEPPER=
APP_LOGIN_MAX_FAILURES=8
APP_LOGIN_WINDOW_MINUTES=15
APP_LOGIN_LOCK_MINUTES=15
APP_PASSWORD_RESET_TTL_MINUTES=30
APP_EMAIL_VERIFICATION_TTL_HOURS=24
APP_EMAIL_PUBLIC_BASE_URL=https://example.com
APP_SMTP_HOST=
APP_SMTP_PORT=465
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_USE_SSL=true
APP_SMTP_USE_TLS=false
APP_EMAIL_FROM=
APP_REQUIRE_MEMBERSHIP_FOR_AI_APIS=false
APP_REQUIRE_TOKEN_BALANCE_FOR_AI_APIS=false
APP_ONE_TIME_MEMBERSHIP_DAYS=30
APP_MONTHLY_MODEL_CALL_LIMIT=0
APP_MONTHLY_TTS_CALL_LIMIT=0
APP_MODEL_API_TOKEN_COST=1
APP_TTS_API_TOKEN_COST=1
APP_ADMIN_EMAILS=

# 国内会员订阅骨架。计划 JSON 只配置在服务端，前端只能选择 plan id。
APP_MEMBERSHIP_PLANS_JSON=[]
# 旧版 Token 套餐配置，仅为旧部署兼容；新站点使用会员计划。
APP_TOKEN_PACKAGES_JSON=[]
APP_PAYMENT_CURRENCY=CNY
APP_PAYMENT_ORDER_TTL_MINUTES=30
APP_PUBLIC_BASE_URL=https://example.com
APP_WECHAT_PAY_ENABLED=false
APP_ALIPAY_ENABLED=false
APP_WECHAT_PAY_NOTIFY_PATH=/api/payments/wechat/notify
APP_ALIPAY_NOTIFY_PATH=/api/payments/alipay/notify

# 微信支付 API v3；密钥只放服务器环境或受限文件，不提交到仓库。
APP_WECHAT_PAY_APP_ID=
APP_WECHAT_PAY_MCH_ID=
APP_WECHAT_PAY_SERIAL_NO=
APP_WECHAT_PAY_PLATFORM_SERIAL_NO=
APP_WECHAT_PAY_PRIVATE_KEY_PATH=
APP_WECHAT_PAY_PRIVATE_KEY_PEM=
APP_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
APP_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=
APP_WECHAT_PAY_API_V3_KEY=
APP_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# 支付宝 RSA2；密钥只放服务器环境或受限文件，不提交到仓库。
APP_ALIPAY_APP_ID=
APP_ALIPAY_PRIVATE_KEY_PATH=
APP_ALIPAY_PRIVATE_KEY_PEM=
APP_ALIPAY_PUBLIC_KEY_PATH=
APP_ALIPAY_PUBLIC_KEY_PEM=
APP_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Stripe 支付；全部配置后，官网账户页才会开放支付按钮
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_PRICE_ID=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_RETURN_URL=https://150.109.13.189/account.html
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://150.109.13.189/account.html
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_AUTOMATIC_TAX_ENABLED=false

# AI Safety（可选，不填则默认复用上面的 LLM 配置）
SAFETY_API_BASE=
SAFETY_API_KEY=
SAFETY_MODEL_NAME=

# ElevenLabs TTS
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_ENABLE_LOGGING=True
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=0
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEED=1.0
ELEVENLABS_USE_SPEAKER_BOOST=True

# 服务端在线神经语音。默认声线与网页试听确认的 01-xiaoyi-gentle.mp3 一致。
TTS_PROVIDER=edge
EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=+12Hz
EDGE_TTS_VOLUME=-2%
EDGE_TTS_TIMEOUT_SECONDS=30
EDGE_TTS_MAX_TEXT_CHARS=2000
# 留空时使用 DATA_DIR/tts-cache。
EDGE_TTS_CACHE_DIR=
EDGE_TTS_CACHE_MAX_BYTES=536870912
EDGE_TTS_CACHE_TTL_SECONDS=7776000
